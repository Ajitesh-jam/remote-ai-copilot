{
  "browser": {
    "mode": "playwright",
    "headless": false,
    "cdpEndpoint": "http://127.0.0.1:9222",
    "extensionEnabled": false,
    "selectedTabOnly": true,
    "maxVisibleTextChars": 12000
  },
  "agent": {
    "defaultMode": "observe",
    "requireGo": true,
    "allowAutomaticSubmission": false,
    "typingMode": "chunked",
    "draftProvider": "stub",
    "host": "127.0.0.1",
    "port": 8787,
    "replaceFocusedOnGo": true
  },
  "typing": {
    "mode": "chunked",
    "charactersPerSecond": 60,
    "chunkSize": 12,
    "delayBetweenChunksMs": 80
  },
  "shortcuts": {
    "prepare": "Control+Option+P",
    "go": "Control+Option+G",
    "halt": "Control+Option+H",
    "resume": "Control+Option+R"
  },
  "server": {
    "mode": "local",
    "url": "ws://127.0.0.1:4000/ws/agent"
  },
  "logging": {
    "level": "debug",
    "redactContent": true,
    "logDirectory": "./logs"
  }
}
